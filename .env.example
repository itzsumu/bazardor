# Better Auth
BETTER_AUTH_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Local SQLite works for development. For Vercel, use a persistent Turso/LibSQL database.
# DATABASE_URL=libsql://your-database-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Optional social login credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

NEXT_PUBLIC_API_BASE_URL=https://openapi.programming-hero.com/api/bazardor
